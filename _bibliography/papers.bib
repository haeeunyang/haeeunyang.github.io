@unpublished{yang2026alliances,
  abstract = {This study empirically investigates the association between a firm's formation of new non-equity strategic alliances and its subsequent hacking breaches, and whether this association varies by the existence of R\&D alliances. In prior research, literature has examined partnerships collectively or focused on specific partner types or industries. To address a gap, this study aims to explain the cybersecurity implications of non-equity strategic alliances across industries, highlighting the differences in the substance of alliance activity. Based on transaction cost economics and a complexity perspective, the study explores why alliance expansion may be associated with cybersecurity risks. It proposes that forming more alliances increases coordination demands regarding information sharing, access rights, and security responsibilities, which can create security gaps. In the case of R\&D alliances, inherent appropriation hazards can induce firms to adopt additional safeguards. When these safeguards are implemented in shared systems and procedures, they can mitigate firm-level cybersecurity risks, weakening the positive association between alliance activity and hacking breaches. To test these hypotheses, the study applies Poisson pseudo-maximum likelihood (PPML) estimation on a panel dataset of S\&P 500 firm-years from 2006 to 2025, combining data from SDC Platinum, Privacy Rights Clearinghouse, and Compustat. Contrary to the expectation, the results show no significant relationship between newly formed non-equity alliances and hacking breaches. However, the interaction between alliance count and the presence of R\&D alliances is negative and statistically significant. These findings suggest that when assessing alliance-related cybersecurity risks, firms may consider looking beyond the number of alliances and understand the content of alliance activities.},
  keywords = {strategic alliance, R\&D alliance, data breach, information security, complexity perspective, transaction cost economics},
  title    = {When Do Strategic Alliances Matter for Firms' Data Breach Risk? The Role of R\&D Alliances},
  author   = {Yang, H. and Cho, W.},
  note     = {Work-in-progress paper accepted for presentation at the Workshop on e-Business (WeB 2026), Lisbon, Portugal, Dec 2026},
  description = {Examines whether newly formed strategic alliances are associated with firms' likelihood of data breaches, and whether R&D alliances moderate this association, using a panel of S\&P 500 firms (2006–2025) built from SDC Platinum, Privacy Rights Clearinghouse, and Compustat.}
}

