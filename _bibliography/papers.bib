@article{jung2026interapp,
  abstract = {This study investigates the inter-app dynamics between mobile application categories, specifically focusing on how media consumption influences mobile shopping behavior. Utilizing hourly usage logs from the Embrain Panel dataset, we applied a Vector Autoregression (VAR) model to empirically analyze the comparative effects of Over-the-Top (OTT) platforms and Social Networking Services (SNS) on shopping app usage over time. The findings reveal distinct temporal patterns: while SNS usage exerts a fluctuating, short-term influence on shopping engagement, OTT usage demonstrates a consistent and cumulative positive impact, suggesting a more sustained pathway to commerce. Furthermore, heterogeneity analyses indicate significant differences by gender and age; the impact of media consumption on shopping is most pronounced among female users and the 30–40 age group, whereas older demographics exhibit delayed responsiveness. By identifying these behavioral disparities, this research highlights the evolving role of streaming platforms as distinct drivers of mobile commerce and provides practical implications for differentiated digital strategies considering user characteristics.},
  keywords = {inter-app dynamics, media consumption and mobile commerce, OTT effects, VAR model, user heterogeneity},
  title    = {Inter-App Dynamics: A VAR Analysis of OTT and SNS Effects on Shopping App Usage},
  author   = {Jung, S. and Yang, H. and Cheung, Y. and Yoon, H. J. and Kwon, Y.},
  journal  = {Journal of Product Research},
  volume   = {44},
  number   = {1},
  pages    = {79--90},
  year     = {2026},
  doi      = {10.36345/kacst.2026.44.1.010},
  selected = {true}
}

@article{cheung2025digital,
  abstract = {The COVID-19 pandemic has significantly accelerated the global shift toward a digital economy, underscoring the critical importance of digital transformation in corporate strategy. This study investigates the relationship between digital activity and financial performance, focusing on the contrasting impacts in the IT and retail industries before and after the pandemic. Using data from 402 firms listed on the KOSPI and KOSDAQ between 2016 and 2023, digital activities were quantified through the frequency of digital-related keywords in annual reports, while financial performance was assessed using Tobin's Q. The results reveal three key insights: first, digital-oriented strategies positively influence financial performance; second, the strength of this positive relationship weakened in the post-COVID-19 period; and third, the IT industry exhibits a stronger correlation between digital activity and financial performance compared to the retail industry. These findings highlight the strategic value of digital transformation in driving financial success, the necessity of industry-specific approaches, and the ongoing importance of innovation to maintain competitive advantages in a rapidly evolving business landscape.},
  keywords = {Digital Activity, Annual Report, Financial Performance, IT Industry, Retail Industry, COVID-19},
  title    = {The Impact of Digital Activity on Financial Performance: A Comparative Analysis of the IT and Retail Industries},
  author   = {Cheung, Y. and Yang, H. and Kwon, Y. and Chang, Y. B.},
  journal  = {Information Systems Review},
  volume   = {27},
  number   = {1},
  pages    = {379--393},
  year     = {2025},
  note     = {In Korean},
  doi      = {10.14329/isr.2025.27.1.379},
  selected = {true}
}
